<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Authors>Zhyra</Authors>
		<Company>XivHub</Company>
		<Version>1.10.0</Version>
		<Description>partake.gg, directly on your client!</Description>
		<Copyright></Copyright>
		<PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/XivHub/PartyPlanner</PackageProjectUrl>
		<IsPackable>false</IsPackable>
		<LangVersion>latest</LangVersion>
		<!-- Distinct assembly/InternalName so this fork can be installed alongside the official PartyPlanner. -->
		<AssemblyName>PartyPlannerReborn</AssemblyName>
		<RootNamespace>PartyPlanner</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ECommons" Version="3.2.1.6" />
		<PackageReference Include="GraphQL.Client" Version="6.1.0" />
		<PackageReference Include="GraphQL.Client.Serializer.Newtonsoft" Version="6.1.0" />
		<PackageReference Include="Humanizer.Core" Version="3.0.1" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="System.Reactive" Version="6.1.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="images\icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
